# Data: 325 MB raw, rebuilt by src/data/fetch_statcast.py; derived tables rebuilt by src/features/
data/raw/
data/processed/

# Model intermediates. Final weights and app artifacts in models/ ARE committed
# so Quick Start runs from a clean clone. Keep each committed file under 50 MB.
models/checkpoints/
models/sweep/
models/sample/

# Per-query eval errors (~10 MB per split): nothing reads them and run_eval rebuilds them;
# the committed summary CSVs are grouped from them.
docs/results/errors_*.csv

# The alpha-blend figure: run_eval still draws it, but no claim rests on the picture
# (alpha_sweep_*.csv and alpha_star.json hold the numbers), so it isn't committed.
docs/figures/alpha_sweep_*.png

